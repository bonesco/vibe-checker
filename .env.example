# Vibe Check Slack App - Environment Variables
# Copy this file to .env and fill in your values

# =============================================================================
# REQUIRED - Slack Configuration
# =============================================================================

# Bot User OAuth Token (starts with xoxb-)
# Get this from: https://api.slack.com/apps > Your App > OAuth & Permissions
SLACK_BOT_TOKEN=xoxb-your-bot-token

# Signing Secret for verifying Slack requests
# Get this from: https://api.slack.com/apps > Your App > Basic Information
SLACK_SIGNING_SECRET=your-signing-secret

# Client ID (used for workspace identification)
# Get this from: https://api.slack.com/apps > Your App > Basic Information
SLACK_CLIENT_ID=your-client-id

# Client Secret
# Get this from: https://api.slack.com/apps > Your App > Basic Information
SLACK_CLIENT_SECRET=your-client-secret

# =============================================================================
# REQUIRED - Database Configuration
# =============================================================================

# Database URL
# For local development (SQLite): sqlite:///vibe_check.db
# For production (PostgreSQL): postgresql://user:password@host:port/database
DATABASE_URL=sqlite:///vibe_check.db

# =============================================================================
# REQUIRED - Security
# =============================================================================

# Encryption key for storing tokens securely (Fernet key)
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=your-fernet-encryption-key

# =============================================================================
# OPTIONAL - Server Configuration
# =============================================================================

# Server port (default: 8000)
PORT=8000

# Log level: DEBUG, INFO, WARNING, ERROR (default: INFO)
LOG_LEVEL=INFO

# =============================================================================
# OPTIONAL - Feature Flags
# =============================================================================

# Enable reminder messages for incomplete standups (default: true)
ENABLE_REMINDERS=true

# Hours to wait before sending reminder (default: 2)
REMINDER_DELAY_HOURS=2

# Days to retain standup/feedback data (default: 90)
DATA_RETENTION_DAYS=90
